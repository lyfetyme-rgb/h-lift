# H-LIFT environment (no credentials are stored here)
# Copy to .env and adjust. H-LIFT does not handle credentials; identity is
# asserted by the DoD identity service via x-hlift-subject / hlift_subject.

# Database location (default: ./data/hlift.db)
HLIFT_DB_PATH=./data/hlift.db

# Demo dataset on first container start (set to 1 to seed, unset for production)
SEED_DEMO=1

# Port
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
