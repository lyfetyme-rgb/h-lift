# H-LIFT environment (no credentials are stored here)
# Copy to .env and adjust. H-LIFT does not handle credentials; identity is
# asserted by the DoD identity service via x-hlift-subject / hlift_subject.

# Database location (default: ./data/hlift.db)
HLIFT_DB_PATH=./data/hlift.db

# Demo dataset on first container start (set to 1 to seed, unset for production)
SEED_DEMO=1

# Port
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Jira integration (optional)
# JIRA_BASE_URL=https://yourco.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=HL
# JIRA_WEBHOOK_SECRET=          # required when HLIFT_ZERO_TRUST=1

# Bitbucket integration (optional)
# BITBUCKET_WORKSPACE=
# BITBUCKET_REPO_SLUG=
# BITBUCKET_USERNAME=
# BITBUCKET_APP_PASSWORD=
# BITBUCKET_WEBHOOK_SECRET=    # required when HLIFT_ZERO_TRUST=1

# Base URL used by server-side integration status fetch
# HLIFT_BASE_URL=http://127.0.0.1:3000

# Zero Trust (NIST 800-207): when enabled, every /api request must carry an
# identity assertion (x-hlift-subject header or hlift_subject cookie) or it is
# rejected with 401. Health and machine webhooks are exempt.
# HLIFT_ZERO_TRUST=0

# SIEM forwarder (optional): POST every audit event to a collector.
# SIEM_WEBHOOK_URL=
# SIEM_WEBHOOK_SECRET=

# TAXII feed access: unset = require the security.events.read capability
# (recommended); set to 1 only for a lab feed with no authentication.
# HLIFT_TAXII_OPEN=
