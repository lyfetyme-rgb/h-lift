{
  "name": "h-lift-traceability",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/seed.mjs --reset",
    "db:verify": "node scripts/verify-seed.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run db:verify",
    "reset:dev": "node scripts/reset-dev.mjs",
    "backup:encrypted": "node scripts/backup-encrypted.mjs",
    "restore:encrypted": "node scripts/restore-encrypted.mjs"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
